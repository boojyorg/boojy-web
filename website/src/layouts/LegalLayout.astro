---
/**
 * Privacy and Terms: a plain title, then the text on a solid card at reading width so
 * the stars never sit behind the words. The card opens with a lead sentence (`intro`) and
 * the page "in short" (`short`), then a hairline, then the detail (the slot).
 */
import '../styles/legal.css';

interface Props {
  title: string;
  updated: string;
  intro: string;
  short: string[];
}

const { title, updated, intro, short } = Astro.props;
---

<section class="legal-hero">
  <h1 class="rise" style="--i:0">{title}</h1>
  <p class="rise" style="--i:1">Last updated: {updated}</p>
</section>
<div class="legal-card rise" style="--i:2">
  <p class="legal-lead">{intro}</p>
  <h2 class="legal-short-title">In short</h2>
  <ul class="legal-short">{short.map((line) => <li>{line}</li>)}</ul>
  <div class="legal-body">
    <slot />
  </div>
</div>
