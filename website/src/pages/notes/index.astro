---
import { NotesDownload, type NotesDownloadUrls } from '../../components/NotesDownload';
import AppLockup from '../../components/AppLockup.astro';
import Features from '../../components/Features.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { findAssetUrl, getLatestRelease } from '../../lib/github-release';
import '../../styles/product.css';

// Build-time fetch — version + real asset URLs are baked into the static HTML and
// re-fetched on each deploy. getLatestRelease never throws (falls back on any
// error/timeout). Notes' asset filenames embed the version, so the download URLs have
// to come from the live release, not a hardcoded path.
const release = await getLatestRelease('boojyorg/boojy-notes', {
  fallbackVersion: 'v0.10.0 Early access',
});
// electron-builder names: x64 is `x86_64` for the AppImage but `amd64` for the .deb.
const downloadUrls: NotesDownloadUrls = {
  macArm64: findAssetUrl(release.assets, /arm64\.dmg$/) ?? null,
  winX64: findAssetUrl(release.assets, /Setup-.*\.exe$/) ?? null,
  linuxAppImageX64: findAssetUrl(release.assets, /x86_64\.AppImage$/) ?? null,
  linuxAppImageArm64: findAssetUrl(release.assets, /arm64\.AppImage$/) ?? null,
  linuxDebX64: findAssetUrl(release.assets, /amd64\.deb$/) ?? null,
  linuxDebArm64: findAssetUrl(release.assets, /arm64\.deb$/) ?? null,
};

const features = [
  { icon: 'folder', title: 'Your files', text: 'Plain .md files in a folder you choose, even an existing Obsidian vault.' },
  { icon: 'slash', title: 'Slash commands', text: 'Type / for any block: headings, lists, tables and code.' },
  { icon: 'file', title: 'Markdown view', text: 'Flip to the raw Markdown of any note, any time.' },
  { icon: 'cloud', title: 'Your cloud', text: 'Works with the cloud storage you already use.' },
] as const;
---

<BaseLayout path="/notes/" page="notes" footer="notes">
  <script
    type="application/ld+json"
    is:inline
    slot="head"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'Boojy Notes',
      applicationCategory: 'ProductivityApplication',
      operatingSystem: 'macOS, Windows, Linux',
      url: 'https://boojy.org/notes/',
      description: 'A calm space for your thoughts. Write in markdown, organize with folders. Free for macOS, Windows and Linux.',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    })}
  />
    <section class="product-hero">
    <h1 class="sr-only">Boojy Notes — a calm place for the notes you own, free for macOS, Windows and Linux</h1>
    <div class="rise" style="--i:0"><AppLockup app="notes" class="product-lockup" /></div>
    <p class="product-tag rise" style="--i:1">A calm place for the notes you own</p>
    <p class="product-key rise" style="--i:2">Plain Markdown files on your computer, no account, no lock-in</p>
    <div class="rise" style="--i:3"><NotesDownload client:load version={release.version} urls={downloadUrls} /></div>
  </section>

  <div class="reading">
    <div class="shotwrap rise pop" style="--i:4" data-theme="dark" id="notes-shot">
      <div class="frame">
        <img class="shot-dark" src="/images/notes-v0.10-dark.jpg" alt="Boojy Notes in dark mode" width="1800" height="1125" decoding="async" />
        <img class="shot-light" src="/images/notes-v0.10-light.jpg" alt="Boojy Notes in light mode" width="1800" height="1125" decoding="async" loading="lazy" />
      </div>
      <div class="themepill" role="group" aria-label="Screenshot theme">
        <button type="button" aria-pressed="true" data-set="dark"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>Dark</button>
        <button type="button" aria-pressed="false" data-set="light"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>Light</button>
      </div>
    </div>
    <Features items={[...features]} repo="https://github.com/boojyorg/boojy-notes" />
  </div>
</BaseLayout>

<script>
  // Dark by default; the pill crossfades to the light screenshot.
  const shot = document.getElementById('notes-shot');
  shot?.querySelectorAll<HTMLButtonElement>('.themepill button').forEach((button) => {
    button.addEventListener('click', () => {
      shot.dataset.theme = button.dataset.set ?? 'dark';
      shot.querySelectorAll('.themepill button').forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
    });
  });
</script>
