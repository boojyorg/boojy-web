---
import { AudioDownload } from '../../components/AudioDownload';
import AppLockup from '../../components/AppLockup.astro';
import Features from '../../components/Features.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLatestRelease } from '../../lib/github-release';
import '../../styles/product.css';

// Build-time fetch — the version is baked into the static HTML and re-fetched on each
// deploy. getLatestRelease never throws (falls back on any error/timeout). Audio ships
// stable, version-less asset names, so only the version string needs the live release.
const release = await getLatestRelease('boojyorg/boojy-audio', {
  fallbackVersion: 'v0.6.0 Early access',
});

const features = [
  { icon: 'mic', title: 'Recording', text: 'From a mic, an audio interface or a MIDI keyboard.' },
  { icon: 'grid', title: 'Beats', text: "Build drum patterns on the drum kit's step grid." },
  { icon: 'sliders', title: 'Mixing', text: 'Built-in effects, plus your own VST3 plugins.' },
  { icon: 'export', title: 'Export', text: 'WAV, MP3 or separate stems for each track.' },
] as const;
---

<BaseLayout path="/audio/" page="audio" footer="audio">
  <script
    type="application/ld+json"
    is:inline
    slot="head"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'Boojy Audio',
      applicationCategory: 'MultimediaApplication',
      operatingSystem: 'macOS, Windows',
      url: 'https://boojy.org/audio/',
      description: 'A free, simple music studio for macOS and Windows. Perfect for making your first beat.',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    })}
  />
    <section class="product-hero">
    <h1 class="sr-only">Boojy Audio — a free, simple music studio for macOS and Windows</h1>
    <div class="rise" style="--i:0"><AppLockup app="audio" class="product-lockup" /></div>
    <p class="product-tag rise" style="--i:1">Music production without the barriers</p>
    <p class="product-key rise" style="--i:2">Easy enough for your first song, with room to grow</p>
    <div class="rise" style="--i:3"><AudioDownload client:load version={release.version} /></div>
  </section>

  <div class="reading">
    <div class="shotwrap rise pop" style="--i:4">
      <div class="frame">
        <img class="shot-dark" src="/images/audio-v0.5.jpg" alt="Boojy Audio with a song open: tracks, clips, the mixer and the piano roll" width="1800" height="1132" decoding="async" />
      </div>
    </div>
    <Features items={[...features]} repo="https://github.com/boojyorg/boojy-audio" />
  </div>
</BaseLayout>
