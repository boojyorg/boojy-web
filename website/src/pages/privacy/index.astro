---
import privacyBody from '../../content/legal/privacy-body.html?raw';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegalLayout from '../../layouts/LegalLayout.astro';
---

<BaseLayout path="/privacy/">
  <LegalLayout
    title="Privacy Policy"
    updated="28 September 2026"
    intro="Boojy is a solo project built by Tyr. I care about your privacy and want to be clear about what data is collected."
    short={[
      'Your notes and projects stay on your computer',
      'No accounts, no ads, and I never sell or share your data',
      'Crash reports in Audio are only sent if you opt in',
    ]}
  >
    <Fragment set:html={privacyBody} />
  </LegalLayout>
</BaseLayout>
