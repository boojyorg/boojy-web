---
import BoojyWordmark from '../components/BoojyWordmark.astro';
import ProductCards from '../components/ProductCards.astro';
import { ABOUT_PARAGRAPHS, ABOUT_PHOTO } from '../content/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';
---

<BaseLayout path="/" page="home">
  <script
    type="application/ld+json"
    is:inline
    slot="head"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'Boojy',
      url: 'https://boojy.org',
      logo: 'https://boojy.org/images/Boojy_Image_Logo.png',
      description: 'Free, open-source creative apps: music production and notes.',
      sameAs: ['https://github.com/boojyorg', 'https://youtube.com/@boojy'],
    })}
  />

  <!-- Hero: the logo sits at the centre of the solar system drawn by the sky (scripts/sky.ts). -->
  <section class="home-hero">
    <h1 class="sr-only">Boojy — free, open-source creative tools</h1>
    <div class="rise" style="--i:0"><BoojyWordmark class="home-logo" /></div>
    <p class="home-title rise" style="--i:1">Your creative space.</p>
    <p class="home-sub rise" style="--i:2">Free, open-source apps. Made by Tyr.</p>
  </section>

  <div class="home-wide">
    <ProductCards />

    <section class="about sr" aria-labelledby="about-title">
      {ABOUT_PHOTO && <img class="about-photo" src={ABOUT_PHOTO.src} alt={ABOUT_PHOTO.alt} width="128" height="128" />}
      <div>
        <h2 id="about-title">Hi, I'm Tyr.</h2>
        {ABOUT_PARAGRAPHS.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>
  </div>
</BaseLayout>
