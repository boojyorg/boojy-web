---
import { GITHUB_ICON_PATH } from '../content/site';
import BoojyMark from './BoojyMark.astro';

// Active route baked in at build time. The nav sits at the top of the page and scrolls
// away with it (pages are kept short, so there's no sticky or reappearing bar).
const path = Astro.url.pathname;
const active = path.startsWith('/audio/') ? 'audio' : path.startsWith('/notes/') ? 'notes' : undefined;
---

<nav class="site-nav" aria-label="Main">
  <a href="/" class="site-nav-brand" aria-label="Boojy home">
    <BoojyMark class="site-nav-mark" variant="hover" />
  </a>
  <div class="site-nav-links">
    <a href="/audio/" class:list={['nav-product', 'nav-audio', { active: active === 'audio' }]}>Audio</a>
    <a href="/notes/" class:list={['nav-product', 'nav-notes', { active: active === 'notes' }]}>Notes</a>
  </div>
  <a href="https://github.com/boojyorg" class="site-nav-gh" aria-label="GitHub" target="_blank" rel="noreferrer">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={GITHUB_ICON_PATH}></path></svg>
  </a>
</nav>

<script>
  // One lap of the mark's planet per hover; a lap in progress is never restarted.
  document.querySelectorAll<HTMLElement>('.site-nav-brand').forEach((brand) => {
    const mark = brand.querySelector('.boojy-mark');
    if (!mark || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    brand.addEventListener('mouseenter', () => mark.classList.add('spin'));
    mark.addEventListener('animationend', () => mark.classList.remove('spin'));
  });
</script>
