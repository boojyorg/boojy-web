---
import { PRODUCT_CARDS } from '../content/site';
import AppWordmark from './AppWordmark.astro';

// The homepage's two apps, Audio then Notes. The whole card is the link; the button inside
// is the visual cue. On hover: a quick lift, a faint wash of the app's colour, the button glows.
const SIZES: Record<string, [number, number]> = { audio: [1800, 1132], notes: [1800, 1125] };
---

<div class="apps">
  {
    PRODUCT_CARDS.map((product) => {
      const [w, h] = SIZES[product.id] ?? [1600, 1000];
      const label = product.id === 'audio' ? 'Audio' : 'Notes';
      return (
        <a class="app product-card rise together" style="--i:4" data-product={product.id} href={product.href} aria-label={`${product.name}: ${product.line}`}>
          <div class="shot">
            <img src={product.screenshot.src} alt={product.screenshot.alt} width={w} height={h} decoding="async" />
          </div>
          <div class="name">
            <AppWordmark app={product.id} />
          </div>
          <p class="line">{product.line}</p>
          <span class={`btn-solid btn-${product.id}`}>Explore {label} →</span>
        </a>
      );
    })
  }
</div>
