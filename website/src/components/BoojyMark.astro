---
/**
 * The Boojy mark as an inline SVG — sun, ring, and the grey planet actually orbiting
 * (CSS offset-path). Redrawn from the suite master, `brand/boojy-mark.svg` in the
 * boojy-suite repo (rules in its `docs/BRAND.md`); the favicons, share image and
 * JSON-LD `logo` in `public/images/` are exports of the same masters.
 *
 * Geometry (the master's): sun c(100,106) r54; ring ellipse rx91.1 ry29.4, stroke 8.5,
 * tilted 30°; planet r16 resting on the ring by its upper tip. Everything that follows
 * the ring sits in one group rotated −30° about the sun's centre, so the ring, the
 * orbit path and the clip halves are all written as a plain, unrotated ellipse. The
 * viewBox is the master's cropped to the drawing, so the mark sizes by height.
 *
 * The z-order trick: the planet must pass BEHIND the sun on the far (upper) side of
 * the orbit and IN FRONT on the near (lower) side. So the ring's near half is redrawn
 * over the sun, and the planet is rendered TWICE running the identical animation, each
 * copy clipped to one half-plane along the ring's long axis (y=106 inside the group).
 * The handoff happens at the ring's two tips, far from the sun, where both copies
 * straddle the clip line and tile seamlessly — it cannot flicker.
 *
 * The orbit path STARTS at the planet's resting position, so reduced-motion users,
 * non-`offset-path` browsers, and the paused lap variant all see the master's exact
 * static mark for free.
 *
 * variant="always"  — planet orbits continuously.
 * variant="lap"     — still at rest; plays one quick lap (slow start, quick middle, slow finish)
 *                     when Nav adds `.spin` on a page-change click. A lap never restarts mid-way.
 * variant="static"  — no animation shipped at all.
 */
interface Props {
  class?: string;
  variant?: 'always' | 'lap' | 'static';
}
const { class: className, variant = 'always' } = Astro.props;
// Unique ids per instance, so two marks on one page can't share clip-path/gradient ids.
const uid = Math.random().toString(36).slice(2, 8);
---

<svg
  viewBox="14.5 39.5 176.5 124"
  class:list={['boojy-mark', `boojy-mark-${variant}`, className]}
  aria-hidden="true"
>
  <defs>
    <!-- Both lit from the upper left, as the Notes N is. -->
    <linearGradient id={`sun-${uid}`} x1="0.12" y1="0.05" x2="0.8" y2="1">
      <stop offset="0" stop-color="#FFD98A"></stop>
      <stop offset="0.55" stop-color="#FDB52A"></stop>
      <stop offset="1" stop-color="#F0940F"></stop>
    </linearGradient>
    <linearGradient id={`planet-${uid}`} x1="0.12" y1="0.05" x2="0.8" y2="1">
      <stop offset="0" stop-color="#B6BAC2"></stop>
      <stop offset="0.55" stop-color="#9498A1"></stop>
      <stop offset="1" stop-color="#797D87"></stop>
    </linearGradient>
    <!-- Half-planes either side of the ring's long axis: "far" above it, "near" below. -->
    <clipPath id={`far-${uid}`}>
      <rect x="-200" y="-194" width="600" height="300"></rect>
    </clipPath>
    <clipPath id={`near-${uid}`}>
      <rect x="-200" y="106" width="600" height="300"></rect>
    </clipPath>
    <clipPath id={`disc-${uid}`}>
      <circle cx="100" cy="106" r="54"></circle>
    </clipPath>
  </defs>

  <!-- Paint order, bottom → top: whole ring → far planet copy → sun → the ring's near
       half where it crosses the sun → near planet copy. The planet is always over the
       ring; only the sun ever hides it. -->
  <g transform="rotate(-30 100 106)">
    <ellipse class="ring" cx="100" cy="106" rx="91.1" ry="29.4"></ellipse>
    <g clip-path={`url(#far-${uid})`}>
      <circle class="planet" r="16" fill={`url(#planet-${uid})`}></circle>
    </g>
  </g>
  <circle class="sun-disc" cx="100" cy="106" r="54" fill={`url(#sun-${uid})`}></circle>
  <g transform="rotate(-30 100 106)">
    <g clip-path={`url(#disc-${uid})`}>
      <ellipse class="ring" cx="100" cy="106" rx="91.1" ry="29.4" clip-path={`url(#near-${uid})`}
      ></ellipse>
    </g>
    <g clip-path={`url(#near-${uid})`}>
      <circle class="planet" r="16" fill={`url(#planet-${uid})`}></circle>
    </g>
  </g>
</svg>

<style is:global>
  .boojy-mark {
    /* Sized by the caller's class (height + width:auto); the ratio keeps width:auto
       honest. Overflow stays visible because the viewBox is cropped to the resting
       mark, and the orbiting planet swings a little past it at the ring's lower-left tip. */
    aspect-ratio: 176.5 / 124;
    overflow: visible;
  }

  .boojy-mark .ring {
    fill: none;
    stroke: #d9dce1;
    stroke-width: 8.5;
  }

  /* Resting position = the orbit path's start point — all fallbacks land here. It is
     the master's planet centre, a touch above the ring's tip (inside the rotated group). */
  .boojy-mark .planet {
    transform: translate(189.1px, 99.87px);
  }

  .boojy-mark .sun-disc {
    transition: filter 0.3s ease;
  }
  a:hover > .boojy-mark .sun-disc {
    filter: brightness(1.08);
  }

  @supports (offset-path: path("M0 0")) {
    .boojy-mark-always .planet,
    .boojy-mark-lap .planet {
      transform: none;
      offset-distance: 0%;
      offset-path: path(
        "M189.1 99.87 A91.1 29.4 0 0 0 10.9 112.13 A91.1 29.4 0 0 0 189.1 99.87"
      );
      offset-rotate: 0deg;
      animation: boojy-orbit 9s linear infinite;
    }

    /* Nav variant: no motion at rest; one lap per page change. */
    .boojy-mark-lap .planet {
      animation: none;
    }
    /* 680ms is LAP_MS in Nav.astro. --lap-offset (negative) resumes a lap that started on
       the previous page, so the orbit carries on across the page change. `reverse` makes
       the lap clockwise (the path itself runs anticlockwise). */
    .boojy-mark-lap.spin .planet {
      animation: boojy-orbit 0.68s ease-in-out var(--lap-offset, 0ms) 1 reverse both;
    }
  }

  @keyframes boojy-orbit {
    to {
      offset-distance: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .boojy-mark .planet {
      animation: none !important;
    }
  }
</style>
