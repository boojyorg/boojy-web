---
import { GITHUB_ICON_PATH } from '../content/site';

/**
 * An app page's "Features": four tiles (Lucide icon, short bold title, one line), then
 * one quiet line linking the source on GitHub. Tiles rise in one after another on scroll.
 */
type Icon = 'folder' | 'slash' | 'file' | 'cloud' | 'mic' | 'grid' | 'sliders' | 'export';
interface Props {
  items: { icon: Icon; title: string; text: string }[];
  repo: string;
}
const { items, repo } = Astro.props;
const ICONS: Record<Icon, string> = {
  folder: '<path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/>',
  slash: '<rect width="18" height="18" x="3" y="3" rx="2"/><line x1="9" x2="15" y1="15" y2="9"/>',
  file: '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/>',
  cloud: '<path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>',
  mic: '<path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/>',
  grid: '<rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M3 15h18"/><path d="M9 3v18"/><path d="M15 3v18"/>',
  sliders: '<line x1="21" x2="14" y1="4" y2="4"/><line x1="10" x2="3" y1="4" y2="4"/><line x1="21" x2="12" y1="12" y2="12"/><line x1="8" x2="3" y1="12" y2="12"/><line x1="21" x2="16" y1="20" y2="20"/><line x1="12" x2="3" y1="20" y2="20"/><line x1="14" x2="14" y1="2" y2="6"/><line x1="8" x2="8" y1="10" y2="14"/><line x1="16" x2="16" y1="18" y2="22"/>',
  export: '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/>',
};
---

<section class="features" aria-labelledby="features-title">
  <h2 id="features-title" class="sr">Features</h2>
  <div class="tiles">
    {
      items.map((item) => (
        <div class="tile sr">
          <svg class="tile-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS[item.icon]} />
          <b>{item.title}</b>
          <span>{item.text}</span>
        </div>
      ))
    }
  </div>
  <p class="gh-line">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d={GITHUB_ICON_PATH}></path></svg>
    Open source · <a href={repo} target="_blank" rel="noreferrer">View the code on GitHub →</a>
  </p>
</section>
