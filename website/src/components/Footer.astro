---
/**
 * One-row footer. On the app pages it sits on the curved edge of that app's planet
 * (`horizon`), in the app's colour.
 */
interface Props {
  horizon?: 'notes' | 'audio';
}
const { horizon } = Astro.props;
---

<div class:list={[{ horizon: !!horizon }, horizon && `horizon-${horizon}`]}>
  <footer class="site-foot">
    <nav aria-label="Footer">
      <a href="/audio/">Audio</a>
      <a href="/notes/">Notes</a>
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
      <a href="https://github.com/boojyorg" target="_blank" rel="noreferrer">GitHub</a>
      <a href="mailto:tyr@boojy.org" class="footer-email">tyr@boojy.org</a>
      <span class="copy">© 2026 Boojy</span>
    </nav>
  </footer>
</div>
